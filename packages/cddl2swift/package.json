{
  "name": "cddl2swift",
  "version": "0.1.1",
  "description": "A Node.js package that can generate Swift type definitions based on a CDDL file",
  "author": "Christian Bromann <mail@bromann.dev>",
  "license": "MIT",
  "homepage": "https://github.com/webdriverio/cddl/blob/main/packages/cddl2swift/README.md",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/webdriverio/cddl.git"
  },
  "keywords": [
    "cddl",
    "swift",
    "codegen"
  ],
  "bugs": {
    "url": "https://github.com/webdriverio/cddl/issues"
  },
  "files": [
    "build",
    "bin"
  ],
  "type": "module",
  "exports": "./build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "cddl2swift": "./bin/cddl2swift.js"
  },
  "scripts": {
    "release": "release-it --config .release-it.ts --VV",
    "release:ci": "pnpm release --ci --npm.skipChecks"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35",
    "@types/node": "^26.0.1"
  },
  "dependencies": {
    "camelcase": "^9.0.0",
    "cddl": "workspace:*",
    "yargs": "^18.0.0"
  }
}
